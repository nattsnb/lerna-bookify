{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "moduleResolution": "node",
    "target": "ES2021",
    "module": "CommonJS",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
